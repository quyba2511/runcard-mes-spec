# Generate URL-safe values with: python scripts/setup_env.py
POSTGRES_PASSWORD=replace-with-a-random-url-safe-value
DEMO_ADMIN_PASSWORD=replace-with-at-least-eight-characters
DEVICE_TOKEN=replace-with-a-random-device-provisioning-value
HTTP_PORT=8080
# No event is marked SENT until a configured endpoint accepts it.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
